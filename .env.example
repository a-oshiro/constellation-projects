# Copy to .env.local (gitignored) and fill in real values — never commit real secrets.
# No VITE_ prefix: this is read server-side only (api/fetch-urls.ts), never bundled into client JS.
OPENAI_API_KEY=

# Portal (api/portal-assets.ts) — server-side only, never VITE_-prefixed.
OFFERS_API_URL=
OFFERS_API_KEY=
OFFERS_CLIENT_ID=

# Disclosure snippet generation: "mock" templatizes locally (no OpenAI credits), "live" calls OpenAI.
# Defaults to mock under `vite dev` and live in production builds when unset.
# VITE_DISCLOSURE_AI_MODE=live
