# Copy to .env.local (gitignored) and fill in real values — never commit real secrets.
# No VITE_ prefix: this is read server-side only (api/fetch-urls.ts), never bundled into client JS.
OPENAI_API_KEY=

# Portal (api/portal-assets.ts) — server-side only, never VITE_-prefixed.
OFFERS_API_URL=
OFFERS_API_KEY=
OFFERS_CLIENT_ID=

# Disclosure template generation calls OpenAI by default, in dev too (`npm run dev` serves the api/
# functions itself). Set to "mock" to templatize locally instead, without spending OpenAI credits.
# VITE_DISCLOSURE_AI_MODE=mock

# Image model for AI Enhance (api/enhance-asset.ts) and background resize (api/generate-image.ts).
# Defaults: gpt-image-2 for AI Enhance, gpt-image-1-mini for background resize.
# OPENAI_IMAGE_MODEL=gpt-image-2
# AI Enhance render tier: low | medium | high (default low).
# OPENAI_ENHANCE_QUALITY=medium
